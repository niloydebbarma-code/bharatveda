# BharatVeda Server Configuration
PORT=3001
NODE_ENV=development

# Optional AI API Key (Groq or OpenAI)
# If left empty, BharatVeda's built-in intelligent cultural & travel knowledge engine will be used automatically.
OPENAI_API_KEY=
GROQ_API_KEY=
# Comma-separated fallback models tried in order.
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
